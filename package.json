{
  "name": "n8n-nodes-speckle",
  "version": "1.0.0",
  "description": "n8n node for interacting with Speckle - AEC data integration",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "speckle",
    "aec",
    "bim",
    "3d-models"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bau-tech/n8n-nodes-speckle",
  "author": "bau-tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bau-tech/n8n-nodes-speckle.git"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && copyfiles -u 1 nodes/**/*.svg dist/nodes && copyfiles -u 1 credentials/**/*.svg dist/credentials",
    "lint": "tsc --noEmit",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SpeckleApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Speckle/Speckle.node.js",
      "dist/nodes/Speckle/SpeckleTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "copyfiles": "^2.4.1",
    "jest": "^30.2.0",
    "n8n-core": "^2.0.1",
    "n8n-workflow": "^1.116.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "dependencies": {
    "axios": "^1.12.0",
    "xml2js": "^0.6.2"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bau-tech/n8n-nodes-speckle/issues"
  }
}
